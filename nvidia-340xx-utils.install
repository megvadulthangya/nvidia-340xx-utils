post_install() {
    mhwd-gpu --check

    # Symlink-ek azonnali beállítása
    if [ -x /usr/bin/nvidia-340xx-lib-switch ]; then
        /usr/bin/nvidia-340xx-lib-switch || true
    fi

    # systemd service regisztrálása, hogy bootkor is lefusson
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable nvidia-340xx-lib-switch.service >/dev/null 2>&1 || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    # Még a fájlok törlése előtt állítsuk vissza a nyílt driver symlinkjeit
    if [ -x /usr/bin/nvidia-340xx-lib-switch ]; then
        /usr/bin/nvidia-340xx-lib-switch || true
    fi
}

post_remove() {
    mhwd-gpu --check

    # systemd service letiltása, mert a csomag már nincs fent
    systemctl disable nvidia-340xx-lib-switch.service >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
}